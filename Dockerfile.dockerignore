# Swift service and scenario-runner context: Swan/Petrel source only.
**
!Swan/
!Swan/**
!Petrel/
!Petrel/**
# Petrel's generated Swift package is the only dependency needed by this
# image. Keep its build caches, server fixtures, and local history out.
Petrel/.build
Petrel/.build*/
Petrel/.build*/**
Petrel/**/.build*
Petrel/.claude
Petrel/.claude/**
Petrel/Server
Petrel/Server/**
Petrel/_trash
Petrel/_trash/**
Petrel/.git
Petrel/.git/**
Petrel/**/.git*
Petrel/.jj
Petrel/.jj/**
Petrel/**/.jj*
Petrel/.venv
Petrel/.venv/**
Petrel/venv
Petrel/venv/**
Petrel/build
Petrel/build/**
# The parent checkout contains several isolated Swift build workspaces. They
# are local caches, never inputs to the release image, and can otherwise make
# a clean BuildKit context many gigabytes larger than the source tree.
Swan/.build
Swan/.build*/
Swan/.build*/**
Swan/**/.build*
Swan/.git
Swan/.git/**
Swan/**/.git*
Swan/.jj
Swan/.jj/**
Swan/**/.jj*
Swan/.DS_Store
Swan/**/.DS_Store
# Acceptance-run output and live laboratory scratch. Neither is an input to the
# release image, and `.interop-live/` holds per-run temporary directories the
# acceptance scripts create under the repository. These must stay above the
# `.interop-cache` re-includes below: a later `!` re-include wins.
Swan/artifacts
Swan/artifacts/**
Swan/.interop-live
Swan/.interop-live/**
Swan/web/node_modules
Swan/web/node_modules/**
Swan/web/.svelte-kit
Swan/web/.svelte-kit/**
Swan/web/build
Swan/web/build/**
Swan/web/test-results
Swan/web/test-results/**
Swan/web/playwright-report
Swan/web/playwright-report/**
web/node_modules
web/node_modules/**
web/.svelte-kit
web/.svelte-kit/**
web/build
web/build/**
web/test-results
web/test-results/**
web/playwright-report
web/playwright-report/**
**/.env*
!**/.env.example
**/.swan-data/
**/.swan-data/**
**/*.sqlite
**/*.sqlite-shm
**/*.sqlite-wal
**/*.pem
**/*.key
**/*.p8
**/keys/
**/keys/**
.swan-interop-secrets/
**/.swan-interop-secrets/
**/.swan-interop-secrets/**
Swan/.interop-cache/**
Swan/**/.interop-cache/**
