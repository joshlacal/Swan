{
  "name": "swan-account-portal",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "svelte-kit sync",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "lint": "eslint . --ignore-pattern 'src/**' --ignore-pattern 'tests/**'",
    "test": "vitest run",
    "test:unit": "vitest run",
    "build": "vite build",
    "test:browser": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@sveltejs/adapter-static": "^4.0.0",
    "@sveltejs/kit": "^3.1.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.19.2",
    "daisyui": "^5.7.50",
    "eslint": "^10.13.0",
    "eslint-plugin-svelte": "^3.23.1",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.7",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "@eslint/js": "^10.0.1"
  },
  "engines": {
    "node": ">=24.22.1 <25",
    "npm": ">=12.2.1 <13"
  },
  "packageManager": "npm@12.2.1",
  "imports": {
    "#lib/*": "./src/lib/*"
  }
}
