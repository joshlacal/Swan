FROM ghcr.io/shopify/toxiproxy:2.13.0@sha256:5d3dae09bc185dcc5ff6cf43abf6062a4a720aff0c4306a471e773acdcd107aa

# Keep the proxy topology in the image so a direct container restart does not
# lose the in-memory definition when the one-shot setup service is not rerun.
COPY Swan/interop/toxiproxy.json /etc/toxiproxy/config.json
