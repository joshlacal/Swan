+const writeAll = async (
+  handle: FileHandle,
+  bytes: Uint8Array,
+): Promise<void> => {
+  let offset = 0
+  while (offset < bytes.byteLength) {
+    const { bytesWritten } = await handle.write(
+      bytes,
+      offset,
+      bytes.byteLength - offset,
+      null,
+    )
+    if (bytesWritten === 0) {
+      throw new Error('Could not make progress writing permissioned repo spool')
+    }
+    offset += bytesWritten
+  }
