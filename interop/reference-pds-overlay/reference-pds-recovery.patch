+/**
+ * Write a CARv1 stream with an ordered root set. Most AT Protocol repos use a
+ * single root; permissioned space recovery deliberately binds a signed commit
+ * and a DRISL index as two roots.
+ */
+export async function* writeCarStreamWithRoots(
+  roots: Cid[],
+  blocks: AsyncIterable<CarBlock>,
+): AsyncIterable<Uint8Array> {
+  yield writeCarHeader(roots)
+  for await (const block of blocks) {
+    yield writeCarBlockHeader(block.cid, block.bytes.byteLength)
+    yield block.bytes
+  }
+}
+
