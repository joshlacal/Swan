+// Encode only the definite-length CBOR map prefix. Each key and CID value is
+// appended separately in canonical order so the DRISL never exists as a
+// process-sized object or Uint8Array.
+const encodeMapHeader = (size: number): Uint8Array => {
+  if (!Number.isSafeInteger(size) || size < 0) {
+    throw new Error('Invalid permissioned repo record count')
+  }
+  if (size < 24) return new Uint8Array([0xa0 | size])
+  if (size <= 0xff) return new Uint8Array([0xb8, size])
+  if (size <= 0xffff) {
+    return new Uint8Array([0xb9, size >>> 8, size & 0xff])
+  }
+  if (size <= 0xffff_ffff) {
+    const result = new Uint8Array(5)
+    result[0] = 0xba
+    new DataView(result.buffer).setUint32(1, size)
+    return result
+  }
+  const result = new Uint8Array(9)
+  result[0] = 0xbb
+  new DataView(result.buffer).setBigUint64(1, BigInt(size))
+  return result
