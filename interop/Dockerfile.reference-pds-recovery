# The recovery-qualified lab image is built from the same immutable pinned
# source archive as the default reference image. The patch is applied only to
# this disposable image and never to Swan/.interop-cache.
FROM node:24.15-alpine3.23 AS build

WORKDIR /app
COPY Swan/.interop-cache/atproto-3f6c96d5d2d25438bd40fa89d6ecc37865f8e354.tar.gz /tmp/reference.tar.gz
COPY Swan/interop/reference-pds-overlay/reference-pds-recovery.patch /tmp/reference-pds-recovery.patch
RUN apk add --no-cache patch \
    && echo "1924ced5c07fb0ae5d8f13f0911bcbd2efc66e9460e463e9d8da10b94e8215ea  /tmp/reference.tar.gz" | sha256sum -c - \
    && echo "363bc352111ae740a543d0dae8f1a6a66f357e67a4bedcadfc949869faa6c237  /tmp/reference-pds-recovery.patch" | sha256sum -c - \
    && tar -xzf /tmp/reference.tar.gz --strip-components=1 -C /app \
    && patch --batch --forward -p1 < /tmp/reference-pds-recovery.patch \
    && test -f /app/services/pds/Dockerfile \
    && test -f /app/pnpm-lock.yaml

RUN npm install --global pnpm@11.5.2
RUN PUPPETEER_SKIP_DOWNLOAD=true pnpm install --frozen-lockfile --prefer-offline \
    && pnpm run --recursive --stream --filter '@atproto/pds...' build \
    && pnpm install --prod --shamefully-hoist --frozen-lockfile --prefer-offline --config.confirmModulesPurge=false

FROM node:24.15-alpine3.23
RUN apk add --no-cache dumb-init
ENTRYPOINT ["dumb-init", "--"]
COPY --from=build /app /app
COPY Swan/interop/run-reference-pds.sh /usr/local/bin/reference-pds-with-file-secrets
WORKDIR /app/services/pds
RUN mkdir /pds \
    && chown node /pds \
    && chmod +x /usr/local/bin/reference-pds-with-file-secrets
VOLUME /pds
EXPOSE 3000
ENV NODE_ENV=production UV_USE_IO_URING=0
USER node
CMD ["/usr/local/bin/reference-pds-with-file-secrets", "node", "--heapsnapshot-signal=SIGUSR2", "--enable-source-maps", "--import=./tracer.ts", "index.ts"]
