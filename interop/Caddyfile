{
	# Caddy's local CA is a lab-only trust anchor. The Compose matrix must add it
	# to its client trust store explicitly; there is no cleartext/public fallback.
	local_certs
}

https://swan.test {
	tls internal
	reverse_proxy swan:3000 {
		header_up X-Swan-Client-IP {http.request.remote.host}
	}
}

