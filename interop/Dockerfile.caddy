FROM caddy:2.11.7-alpine@sha256:504a44d7d74bd2bc28a66afc4774912fc21223ca8a67734af1c54ab2f999b489

# Keep the lab routing configuration in the image. A host file bind is not
# portable across Docker Desktop and native Linux engines: missing bind targets
# can be inferred as directories during OCI setup.
COPY Swan/interop/Caddyfile /etc/caddy/Caddyfile
