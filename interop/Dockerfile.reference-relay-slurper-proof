FROM docker.io/library/golang@sha256:972b4110ba0f47539a975c31e52c64765e1ff19f2d74469ae4a595c6676e80a5 AS prepared

ENV CGO_ENABLED=1 GOPROXY=off GOTOOLCHAIN=local GOFLAGS=-mod=vendor
COPY .interop-cache/indigo-8b43a326dbbb394f63b6d68761553cdfe25532de/indigo-8b43a326dbbb394f63b6d68761553cdfe25532de.tar.gz /tmp/indigo.tar.gz
COPY .interop-cache/indigo-vendor-8b43a326dbbb394f63b6d68761553cdfe25532de/indigo-8b43a326dbbb394f63b6d68761553cdfe25532de.vendor.tar.gz /tmp/indigo.vendor.tar.gz
COPY interop/reference-relay-overlay/reference-relay-private-upstream.patch /tmp/reference-relay-private-upstream.patch
COPY interop/apply-reference-relay-overlay.go /tmp/apply-reference-relay-overlay.go
COPY interop/reference-relay-slurper-private-upstream_test.go /tmp/reference-relay-slurper-private-upstream_test.go
COPY interop/reference-relay-slurper-proof.go /tmp/reference-relay-slurper-proof.go

RUN --network=none echo "bc6f57e6211560220ac49dc7d6b55c5a43291f1e1193113ce413ffe4478fdd0b  /tmp/indigo.tar.gz" | sha256sum -c - \
    && echo "ee11abd21e9ba70aabc013e92f877b248fdd381ea7de35a3c76f85857217c8c1  /tmp/indigo.vendor.tar.gz" | sha256sum -c - \
    && echo "7867e9f31a4ea5ccb36ed880cf66ea60d911ccb2366934dda0c14561db89136d  /tmp/reference-relay-private-upstream.patch" | sha256sum -c - \
    && mkdir /src /out \
    && tar -xzf /tmp/indigo.tar.gz --strip-components=1 -C /src \
    && tar -xzf /tmp/indigo.vendor.tar.gz -C /src \
    && cp /src/cmd/relay/relay/slurper.go /tmp/slurper.public-only.go \
    && go run /tmp/apply-reference-relay-overlay.go /src /tmp/reference-relay-private-upstream.patch \
    && cp /tmp/reference-relay-slurper-private-upstream_test.go /src/cmd/relay/relay/reference_relay_slurper_private_upstream_test.go \
    && mkdir -p /src/cmd/reference-relay-slurper-proof \
    && cp /tmp/reference-relay-slurper-proof.go /src/cmd/reference-relay-slurper-proof/main.go \
    && cd /src \
    && CGO_ENABLED=0 go build -o /out/reference-relay-slurper-proof-helper ./cmd/reference-relay-slurper-proof

FROM prepared AS patched-build
RUN --network=none cd /src \
    && go test -c -tags 'timetzdata netgo osusergo sqlite_omit_load_extension' -ldflags '-linkmode external -extldflags "-static"' -o /out/reference-relay-slurper-proof ./cmd/relay/relay

FROM prepared AS public-only-build
RUN --network=none cp /tmp/slurper.public-only.go /src/cmd/relay/relay/slurper.go \
    && cd /src \
    && go test -c -tags 'timetzdata netgo osusergo sqlite_omit_load_extension' -ldflags '-linkmode external -extldflags "-static"' -o /out/reference-relay-slurper-proof ./cmd/relay/relay

FROM docker.io/library/golang@sha256:754d5200fc3edae76d3b6598a9a3fac7e74981ee6a5413ab955025f185753ef2 AS upstream
COPY --from=prepared /out/reference-relay-slurper-proof-helper /usr/local/bin/reference-relay-slurper-proof
USER 65532:65532
ENTRYPOINT ["/usr/local/bin/reference-relay-slurper-proof"]
CMD ["serve"]
HEALTHCHECK --interval=1s --timeout=3s --retries=15 CMD ["/usr/local/bin/reference-relay-slurper-proof", "health", "http://127.0.0.1:3000/health"]

FROM ghcr.io/shopify/toxiproxy:2.13.0@sha256:5d3dae09bc185dcc5ff6cf43abf6062a4a720aff0c4306a471e773acdcd107aa AS toxiproxy
COPY --from=prepared /out/reference-relay-slurper-proof-helper /reference-relay-slurper-proof
COPY interop/toxiproxy.reference-relay.json /etc/toxiproxy/config.json
HEALTHCHECK --interval=1s --timeout=3s --retries=15 CMD ["/reference-relay-slurper-proof", "health", "http://127.0.0.1:8474/version"]

FROM docker.io/library/golang@sha256:754d5200fc3edae76d3b6598a9a3fac7e74981ee6a5413ab955025f185753ef2 AS patched
COPY --from=patched-build /out/reference-relay-slurper-proof /usr/local/bin/reference-relay-slurper-proof
USER 65532:65532
ENTRYPOINT ["/usr/local/bin/reference-relay-slurper-proof"]
CMD ["-test.v", "-test.run=^TestReferenceRelaySlurperPrivateWSS$", "-test.count=1", "-test.timeout=12s"]

FROM docker.io/library/golang@sha256:754d5200fc3edae76d3b6598a9a3fac7e74981ee6a5413ab955025f185753ef2 AS public-only
COPY --from=public-only-build /out/reference-relay-slurper-proof /usr/local/bin/reference-relay-slurper-proof
USER 65532:65532
ENTRYPOINT ["/usr/local/bin/reference-relay-slurper-proof"]
CMD ["-test.v", "-test.run=^TestReferenceRelaySlurperPrivateWSS$", "-test.count=1", "-test.timeout=12s"]
